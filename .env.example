# Copy thành .env rồi sửa giá trị. KHÔNG commit file .env.

# --- Hạ tầng (docker-compose.yml) ---
POSTGRES_DB=omniai
POSTGRES_USER=omniai
POSTGRES_PASSWORD=omniai
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# --- Backend (Spring Boot) ---
DB_URL=jdbc:postgresql://localhost:5432/omniai
DB_USERNAME=omniai
DB_PASSWORD=omniai
BRAIN_URL=http://localhost:8000
OMNIAI_POLICY_DIR=../shared/policies
# Tài khoản admin cho /api/admin/** (HTTP Basic, SRS Q-01). Đổi mật khẩu nếu chạy ngoài máy dev.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# --- AI Brain (FastAPI) ---
# fake = trả lời theo luật cố định, không cần API key (mặc định khi dev và bench).
# gemini / groq cần LLM_API_KEY. LLM_MODEL để trống thì dùng model của decisions #14.
LLM_PROVIDER=fake
LLM_MODEL=
LLM_API_KEY=

# --- Kênh (điền khi tới sprint tương ứng) ---
TELEGRAM_BOT_TOKEN=
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
