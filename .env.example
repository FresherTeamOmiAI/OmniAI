# Copy thành .env rồi sửa giá trị. KHÔNG commit file .env.

# --- Hạ tầng (docker-compose.yml) ---
POSTGRES_DB=omniai
POSTGRES_USER=omniai
POSTGRES_PASSWORD=omniai
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# --- Backend (Spring Boot) ---
DB_URL=jdbc:postgresql://localhost:5432/omniai
DB_USERNAME=omniai
DB_PASSWORD=omniai
BRAIN_URL=http://localhost:8000
OMNIAI_POLICY_DIR=../shared/policies
# Tài khoản admin cho /api/admin/** (HTTP Basic, SRS Q-01). Đổi mật khẩu nếu chạy ngoài máy dev.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# --- AI Brain (FastAPI) ---
# Chỉ có LLM thật: gemini (mặc định) hoặc groq. BẮT BUỘC điền LLM_API_KEY, thiếu thì brain không khởi động.
# Không còn LLM_PROVIDER=fake (decisions #25). LLM_MODEL để trống thì dùng model của decisions #14.
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_API_KEY=

# Role chatbot_reader, chỉ SELECT view chatbot_catalog. Mật khẩu local của demo.
# BẮT BUỘC: brain luôn đọc catalog từ Postgres thật, thiếu CHATBOT_DB_URL thì brain không khởi động.
CHATBOT_DB_PASSWORD=chatbot_reader
CHATBOT_DB_URL=postgresql://chatbot_reader:chatbot_reader@localhost:5432/omniai

# --- Kênh sàn: khóa test để simulator ký webhook và adapter kiểm chữ ký (US-21, US-25) ---
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# Khóa test dùng chung cho simulator TikTok Shop và backend (không phải bí mật, đổi thì đổi ở cả hai)
TIKTOK_APP_KEY=omniai-test-app
TIKTOK_APP_SECRET=omniai-test-secret
# Simulator TikTok Shop (simulators/tiktok-shop, decisions #28)
TIKTOK_SIM_PORT=8090
TIKTOK_SIM_URL=http://localhost:8090
# Địa chỉ của hub mà simulator gọi tới: webhook và redirect sau khi seller ủy quyền
TIKTOK_WEBHOOK_URL=http://localhost:8080/api/channels/tiktok/webhook
TIKTOK_REDIRECT_URI=http://localhost:8080/api/channels/tiktok/oauth/callback
