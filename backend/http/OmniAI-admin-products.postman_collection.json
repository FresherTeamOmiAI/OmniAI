              "raw": "{\n  \"sku\": \"  {{test_sku_lower}}  \",\n  \"name\": \"Serum thử nghiệm Niacinamide 5% (Postman)\",\n  \"brand\": \"Lumi Lab\",\n  \"category\": \"serum\",\n  \"skinTypes\": \"Oily, oily ,DRY\",\n  \"skinConcerns\": \"pores,oil-control\",\n  \"usageTime\": \"am,pm\",\n  \"description\": \"Sản phẩm tạo bởi Postman để test API admin. Tự ẩn ở bước cuối.\",\n  \"ingredientsInci\": \"Aqua,Niacinamide , Glycerin\",\n  \"sizeMl\": 30,\n  \"paoMonths\": 12,\n  \"priceWeb\": 250000,\n  \"priceShopee\": 260000,\n  \"priceTiktok\": 243000,\n  \"stock\": 10\n}",
