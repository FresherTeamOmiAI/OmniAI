    {
      "name": "3. Tạo mới",
      "item": [
        {
          "name": "Tạo mới -> 201 (SKU ngẫu nhiên)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// SKU dạng BRAND-LOAI-NN, brand ngẫu nhiên QAxx để chạy lại nhiều lần không trùng.",
                  "const L = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\";",
                  "const r = () => L[Math.floor(Math.random() * 26)];",
                  "const sku = \"QA\" + r() + r() + \"-SER-\" + String(Math.floor(Math.random() * 90) + 10);",
                  "pm.collectionVariables.set(\"test_sku\", sku);",
                  "pm.collectionVariables.set(\"test_sku_lower\", sku.toLowerCase());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 + Location\", () => {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(pm.response.headers.get(\"Location\")).to.match(/\\/api\\/admin\\/products\\/\\d+$/);",
                  "});",
                  "const p = pm.response.json();",
                  "pm.test(\"Server chuẩn hóa dữ liệu\", () => {",
                  "    pm.expect(p.sku).to.eql(pm.collectionVariables.get(\"test_sku\"));",
                  "    pm.expect(p.skinTypes).to.eql(\"oily,dry\");",
                  "    pm.expect(p.ingredientsInci).to.eql(\"Aqua, Niacinamide, Glycerin\");",
                  "    pm.expect(p.active).to.eql(true);",
                  "});",
                  "pm.collectionVariables.set(\"product_id\", p.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/products",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "admin",
                "products"
              ]
            },
            "description": "Gửi SKU viết thường có khoảng trắng, skinTypes lộn xộn để kiểm tra server chuẩn hóa. Nếu báo 409 thì SKU ngẫu nhiên trùng, bấm Send lại.",
            "body": {
